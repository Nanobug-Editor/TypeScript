{
  "id": "unfamiliar-ecosystem",
  "name": "Unfamiliar ecosystem fixture",
  "version": "0.1.2",
  "protocol": 7,
  "component": "plugin.wasm",
  "storage_limit": 1024,
  "api": {
    "base": "^1",
    "required": {
      "plugin.services": ">=1.2,<2",
      "language.modules": "^1",
      "package.assets": "^1"
    }
  },
  "permissions": [
    "assets.read",
    "native.modules",
    "editor.read",
    "workspace.read"
  ],
  "plugin_services": {
    "provides": {
      "language.contribution": {
        "version": "1.0.0",
        "collection": true,
        "methods": {
          "prepare": {
            "parameters": {
              "type": "record",
              "fields": {
                "document": {
                  "type": "record",
                  "fields": {
                    "path": {
                      "type": "string",
                      "max_bytes": 4096
                    },
                    "generation": {
                      "type": "integer",
                      "min": 0,
                      "max": 9007199254740991
                    }
                  }
                },
                "payload": {
                  "type": "string",
                  "max_bytes": 49152
                }
              }
            },
            "result": {
              "type": "record",
              "fields": {
                "payload": {
                  "type": "string",
                  "max_bytes": 49152
                }
              }
            },
            "permissions": [
              "editor.read",
              "workspace.read",
              "native.modules"
            ]
          }
        }
      }
    }
  },
